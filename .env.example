# Cadence environment. Copy to .env on the box (chmod 600) and fill in.
# The repo NEVER contains real secrets — only this template (ISC-80, ISC-84).

# --- Server ---
PORT=4100
# Absolute path on the box, e.g. /opt/cadence/cadence.db
DB_PATH=./cadence.db
# Reserved for future signed-cookie use; sessions are random UUID rows today,
# but set a strong random value so nothing depends on a default.
SESSION_SECRET=change-me-to-a-long-random-string
# Public base URL, used only for operator-facing messages/logs.
BASE_URL=https://fit.austinfiala.com

# --- Garmin Connect (fill only when Austin connects his account) ---
# Credentials live ONLY here on the box (mode 600), never in git. Used once
# for the first login; after that the persisted session token is reused.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Where the persisted Garmin session (OAuth tokens) is written, mode 600.
GARMIN_TOKEN_PATH=./garmin-tokens/session.json
# Set transiently ONLY for the first login if Garmin prompts for MFA, then
# unset. Subsequent syncs reuse the saved session and never prompt again.
# GARMIN_MFA_CODE=

# --- ZwiftPower (fill only when Austin connects his account) ---
# Zwift SSO credentials, used to authenticate to ZwiftPower. Live ONLY here on
# the box (mode 600), never in git, the DB, or logs. With both left empty the
# whole ZwiftPower feature stays dormant: no scheduler, no errors, and the
# Races tab shows a "not connected" panel.
ZWIFT_USERNAME=
ZWIFT_PASSWORD=
# Your numeric ZwiftPower profile id: the number in your ZwiftPower profile
# URL (zwiftpower.com/profile.php?z=NNNN). Required for results to be fetched.
# One-time setup: your ZwiftPower profile must be activated once by logging in
# at zwiftpower.com and linking your Zwift account, or the results feed is empty.
ZWIFT_PROFILE_ID=
# Where the persisted ZwiftPower session cookies are written, mode 600, so
# re-auth is not needed every sync. A *.json value is the cookie file itself.
ZWIFT_COOKIE_PATH=./zwiftpower-tokens/session.json

# --- Nutrition estimation (fill only to enable LLM calorie/macro estimates) ---
# Direct Anthropic API key (sk-ant-...). Used ONLY by src/services/
# nutritionEstimate.ts via a direct HTTPS fetch, never the claude CLI and never
# OAuth billing. With this empty the Nutrition tab still works: auto-estimate
# reports "unavailable" and the UI/MCP fall back to manual macro entry, never a
# fabricated number.
ANTHROPIC_API_KEY=
# Optional model override for estimates. Defaults to a small, cheap model.
# NUTRITION_MODEL=claude-haiku-4-5-20251001

# --- Ops toggles ---
# Set to 1 to disable the in-process 6h sync scheduler (used in tests/CI).
# CADENCE_DISABLE_SCHEDULER=0
